# Copy to tokens/.env (ignored by git) and fill in. Use a wallet made only for testing.
# Private key of the wallet that pays the deploy gas (0x + 64 hex characters).
DEPLOYER_PRIVATE_KEY=
# Wallet that receives the whole supply of each coin (defaults to the deployer).
RECIPIENT_ADDRESS=
# RPC endpoints (the public ones work for a few transactions).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
# Optional: Etherscan API key (V2, one key for all chains) to verify the source code.
ETHERSCAN_API_KEY=
# Optional: where the metadata JSON and logos are served (default: GitHub raw, branch main).
METADATA_BASE_URL=
