{
  "name": "the-four-exiles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p functions && vite build",
    "build:static": "tsc -b && tsc -p functions && vite build --mode static --base ./",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-api.mjs",
    "db:migrate:local": "wrangler d1 migrations apply four-exiles --local",
    "pages:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "3.2.7",
    "wrangler": "4.161.0"
  }
}
